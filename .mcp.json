{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "serena": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--network",
        "host",
        "-v",
        "/home/user/PycharmProjects/diploma-maker:/workspace",
        "-w",
        "/workspace",
        "ghcr.io/oraios/serena:latest",
        "serena",
        "start-mcp-server",
        "--context=codex",
        "--project=/workspace"
      ]
    }
  }
}
