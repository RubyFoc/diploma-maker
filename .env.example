# Copy to .env and fill in real values. Never commit .env.

# LLM routing (DeepSeek dynamic model routing — see docs/architecture/overview.md)
DEEPSEEK_API_KEY=
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_HEAVY_MODEL=deepseek-v4-pro

# Primary database (user profiles, institution formatting configs)
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=diploma_maker

# Vector database (RAG over uploaded drafts/literature)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=diploma_maker_documents

# Async task queue (ADR-0013): Celery broker + result backend, no auth needed for local dev
REDIS_URL=redis://redis:6379/0

# Backend
# Host ports 8000/27017 are commonly already taken by other local projects; default to
# non-conflicting host ports here (internal container ports/service names are unaffected).
BACKEND_PORT=8010
MONGO_HOST_PORT=27018
REDIS_HOST_PORT=6380
JWT_SECRET_KEY=change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8010

# External source search (sources.search/sources.web_search) — all optional; each provider is
# skipped entirely (not attempted-and-failed) if its keys are unset. Semantic Scholar needs no
# key for basic use; setting SEMANTIC_SCHOLAR_API_KEY only raises its rate limit.
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
# Google Custom Search JSON API (user request): a last-resort general-web-search grounding
# fallback for a required source neither a direct URL nor academic search can ground — create a
# search engine at https://programmablesearchengine.google.com/ (set it to search the whole web)
# for GOOGLE_CSE_CX, and an API key at https://console.cloud.google.com/apis/credentials.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Monitoring
SENTRY_DSN=
